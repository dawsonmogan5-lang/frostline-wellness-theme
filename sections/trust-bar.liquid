<div class="trust-bar">
  <div class="trust-bar-inner">
    {% for item in section.blocks %}
      <div class="trust-item">
        <span class="trust-icon">[&#10003;]</span>
        <span>{{ item.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Trust Bar",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Trust badge text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "text": "Free Shipping"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Official PlungeZero Dealer"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "1 Year Commercial and Residential Warranty"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "text": "Idaho & Utah Service Area"
          }
        }
      ]
    }
  ]
}
{% endschema %}
